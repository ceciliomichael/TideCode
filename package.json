{
  "name": "tidecode",
  "description": "A focused desktop AI workspace for efficient software work.",
  "author": "TideCode Team",
  "private": true,
  "version": "1.4.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "cli": "tsx electron/cli/index.ts",
    "postinstall": "node ./scripts/sync-ripgrep-binary.mjs",
    "predev": "node ./scripts/sync-ripgrep-binary.mjs && node ./scripts/generate-electron-icons.mjs",
    "clean:build": "node ./scripts/clean-build-output.mjs",
    "prebuild": "npm run clean:build && node ./scripts/sync-ripgrep-binary.mjs",
    "ripgrep:sync": "node ./scripts/sync-ripgrep-binary.mjs",
    "typecheck": "tsc --noEmit",
    "audit:prompt": "node --import tsx scripts/dumpPromptAndToolsContext.ts",
    "test": "node --import tsx --test",
    "build": "tsc && vite build && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "icons:generate": "node ./scripts/generate-electron-icons.mjs",
    "installer:assets": "node ./scripts/generate-installer-assets.mjs",
    "dist": "npm run build && npm run icons:generate && npm run installer:assets && electron-builder --publish never",
    "dist:win": "npm run build && npm run icons:generate && npm run installer:assets && electron-builder --win --x64 --publish never",
    "dist:win:fast": "npm run build && npm run icons:generate && npm run installer:assets && electron-builder --win --x64 -c.compression=store --publish never",
    "dist:linux": "npm run build && npm run icons:generate && electron-builder --linux AppImage --x64 --publish never",
    "dist:mac": "npm run build && npm run icons:generate && electron-builder --mac dmg --publish never",
    "dist:publish": "npm run build && npm run icons:generate && npm run installer:assets && electron-builder --publish always",
    "dist:win:publish": "npm run build && npm run icons:generate && npm run installer:assets && electron-builder --win --x64 --publish always",
    "dist:linux:publish": "npm run build && npm run icons:generate && electron-builder --linux AppImage --x64 --publish always",
    "dist:mac:publish": "npm run build && npm run icons:generate && electron-builder --mac dmg --publish always",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:tools": "node --import tsx --test tests/openaiCompatible/*.test.ts tests/codex/*.test.ts tests/scripts/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.68",
    "@ai-sdk/google": "^4.0.85",
    "@ai-sdk/mistral": "^4.0.54",
    "@ai-sdk/openai": "^4.0.81",
    "@ai-sdk/openai-compatible": "^3.0.59",
    "@ai-sdk/provider-utils": "^5.0.51",
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@monaco-editor/react": "^4.7.0",
    "@shikijs/monaco": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "acorn": "^8.18.0",
    "ai": "^7.0.122",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.1",
    "electron-updater": "^6.8.9",
    "ignore": "^7.0.10",
    "import-meta-resolve": "^4.2.0",
    "lucide-react": "^1.48.0",
    "mermaid": "^12.0.0",
    "minimatch": "^10.2.6",
    "monaco-themes": "^0.4.8",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uiohook-napi": "^1.5.5",
    "uuid": "^14.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "main": "dist-electron/main.js",
  "allowScripts": {
    "@vscode/ripgrep@1.18.0": true,
    "electron@43.7.5": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "node-pty@1.1.0": true,
    "sharp@0.35.5": true,
    "uiohook-napi@1.5.5": true
  }
}
