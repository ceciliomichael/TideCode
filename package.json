{
  "name": "echosphere",
  "description": "Desktop AI workspace built with Electron, Vite, and React.",
  "author": "Echosphere Team",
  "private": true,
  "version": "0.2.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "node ./scripts/sync-ripgrep-binary.mjs",
    "predev": "node ./scripts/sync-ripgrep-binary.mjs",
    "prebuild": "node ./scripts/sync-ripgrep-binary.mjs",
    "ripgrep:sync": "node ./scripts/sync-ripgrep-binary.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "icons:generate": "node ./scripts/generate-electron-icons.mjs",
    "dist": "npm run build && npm run icons:generate && electron-builder --publish never",
    "dist:win": "npm run build && npm run icons:generate && electron-builder --win --x64 --publish never",
    "dist:win:fast": "npm run build && npm run icons:generate && electron-builder --win --x64 -c.compression=store --publish never",
    "dist:linux": "npm run build && npm run icons:generate && electron-builder --linux AppImage --x64 --publish never",
    "dist:mac": "npm run build && npm run icons:generate && electron-builder --mac dmg --publish never",
    "dist:publish": "npm run build && npm run icons:generate && electron-builder --publish always",
    "dist:win:publish": "npm run build && npm run icons:generate && electron-builder --win --x64 --publish always",
    "dist:linux:publish": "npm run build && npm run icons:generate && electron-builder --linux AppImage --x64 --publish always",
    "dist:mac:publish": "npm run build && npm run icons:generate && electron-builder --mac dmg --publish always",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:tools": "node --import tsx --test tests/openaiCompatible/*.test.ts tests/codex/*.test.ts tests/scripts/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/google": "^4.0.18",
    "@ai-sdk/mistral": "^4.0.13",
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/openai-compatible": "^3.0.12",
    "@ai-sdk/provider-utils": "^5.0.11",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@shikijs/monaco": "^4.3.0",
    "@tailwindcss/vite": "^4.2.1",
    "@vscode/ripgrep": "^1.17.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.31",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "ignore": "^7.0.5",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.14.0",
    "minimatch": "^10.2.5",
    "monaco-themes": "^0.4.8",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^43.2.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "png-to-ico": "^2.1.8",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js",
  "allowScripts": {
    "@vscode/ripgrep@1.17.1": true,
    "electron@43.2.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.27.7": true,
    "node-pty@1.1.0": true,
    "sharp@0.34.5": true
  }
}
